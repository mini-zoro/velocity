// Hand-authored control assignments for general Preferences.sublime-settings.
// See docs/settings.md and the comments next to the shipped defaults. The runtime
// type validator is vel-config/settings.rs::validate_layer. Numeric bounds are
// graphical editing bounds; the JSON editor still accepts the full runtime domain.
// show_when and choices are reserved for R2 controls. Mixed-type legacy values
// remain intact and can be edited in JSON even when the row has an R1 control.
{

  // Editing and Vintage: docs/settings.md, the Default comments and the Vintage reference at https://www.sublimetext.com/docs/vintage.html.
  "tab_size": {"group": "editing", "control": "number", "range": [1,32], "step": 1, "note": "Spaces represented by a tab.", "aliases": ["indent","制表符宽度","缩进"], "name": "Tab Size"},
  "translate_tabs_to_spaces": {"group": "editing", "control": "bool", "note": "Insert spaces instead of tab characters.", "aliases": ["spaces","空格代替制表符"]},
  "word_wrap": {"group": "editing", "control": "enum", "choices": ["auto",true,false], "note": "Wrap long lines at the configured width or the viewport.", "aliases": ["wrap","自动换行","换行"]},
  "wrap_width": {"group": "editing", "control": "number", "range": [0,10000], "step": 1, "note": "Wrap at this column. Zero uses the available width.", "aliases": ["columns","换行宽度"], "show_when": {"word_wrap": {"not": false}}},
  "wrap_width_style": {"group": "editing", "control": "enum", "choices": ["auto","fixed"], "note": "Use a fixed wrap column even when it exceeds the viewport.", "show_when": {"word_wrap": {"not": false}}},
  "indent_subsequent_lines": {"group": "editing", "control": "bool", "note": "Indent wrapped continuation lines."},
  "draw_indent_guides": {"group": "editing", "control": "bool", "note": "Draw guides for indentation levels."},
  "indent_guide_options": {"group": "editing", "control": "array", "choices": ["draw_normal","draw_active"], "show_when": {"draw_indent_guides": true}},
  "auto_indent": {"group": "editing", "control": "bool"},
  "smart_indent": {"group": "editing", "control": "bool"},
  "indent_to_bracket": {"group": "editing", "control": "bool"},
  "auto_match_enabled": {"group": "editing", "control": "bool", "note": "Insert matching brackets and quotes while typing."},
  "auto_close_tags": {"group": "editing", "control": "bool"},
  "drag_text": {"group": "editing", "control": "bool"},
  "trim_automatic_white_space": {"group": "editing", "control": "bool"},
  "shift_tab_unindent": {"group": "editing", "control": "bool"},
  "use_tab_stops": {"group": "editing", "control": "bool"},
  "copy_with_empty_selection": {"group": "editing", "control": "bool"},
  "word_separators": {"group": "editing", "control": "text", "aliases": ["word boundaries","单词分隔符"]},
  "sub_word_separators": {"group": "editing", "control": "text"},
  "move_to_limit_on_up_down": {"group": "editing", "control": "bool"},
  "match_brackets": {"group": "editing", "control": "bool", "note": "Highlight the matching bracket at the caret."},
  "match_brackets_content": {"group": "editing", "control": "bool", "note": "Highlight brackets around the text between them."},
  "match_brackets_square": {"group": "editing", "control": "bool", "note": "Match square brackets."},
  "match_brackets_braces": {"group": "editing", "control": "bool", "note": "Match braces."},
  "match_brackets_angle": {"group": "editing", "control": "bool", "note": "Match angle brackets."},
  "match_tags": {"group": "editing", "control": "bool", "note": "Match opening and closing markup tags."},
  "vintage_enabled": {"group": "editing", "control": "bool", "note": "Enable Vintage modal editing."},
  "vintage_start_in_command_mode": {"group": "editing", "control": "bool", "note": "Start in command mode when a view enters Vintage."},
  "vintage_ctrl_keys": {"group": "editing", "control": "enum", "choices": [null,true,false], "name": "Vintage Ctrl Keys"},
  "vintage_use_clipboard": {"group": "editing", "control": "bool", "note": "Use the system clipboard for Vintage registers."},

  // Display: docs/settings.md and the Default comments; enum values follow view.rs, panels.rs, and the shipped themes.
  "line_numbers": {"group": "appearance", "control": "bool", "note": "Show line numbers next to the text.", "aliases": ["行号"]},
  "relative_line_numbers": {"group": "appearance", "control": "bool", "note": "Number lines relative to the caret."},
  "gutter": {"group": "appearance", "control": "bool", "note": "Show the editor gutter."},
  "highlight_line": {"group": "appearance", "control": "bool", "note": "Highlight the line containing the caret."},
  "highlight_line_number": {"group": "appearance", "control": "bool"},
  "match_selection": {"group": "appearance", "control": "bool", "note": "Highlight other occurrences of the selected word."},
  "fold_buttons": {"group": "appearance", "control": "bool", "note": "Show fold controls in the gutter."},
  "fade_fold_buttons": {"group": "appearance", "control": "bool", "note": "Reveal fold controls on hover instead of showing them constantly."},
  "draw_white_space": {"group": "appearance", "control": "enum", "choices": ["none","selection","leading","trailing","all",null], "note": "Show spaces and tabs with visible marks. Use JSON to combine multiple modes.", "aliases": ["空白字符"], "name": "Draw White Space"},
  "draw_unicode_white_space": {"group": "appearance", "control": "enum", "choices": ["none","punctuation","all"], "note": "Show selected Unicode whitespace marks."},
  "draw_unicode_bidi": {"group": "appearance", "control": "bool", "note": "Show bidirectional control characters."},
  "draw_control_characters": {"group": "appearance", "control": "bool", "note": "Show invisible control characters."},
  "caret_style": {"group": "appearance", "control": "enum", "choices": ["solid","blink","smooth","phase","block","underline"], "note": "Choose the insertion caret's shape or blink behavior.", "aliases": ["cursor","光标"]},
  "block_caret": {"group": "appearance", "control": "bool"},
  "inverse_caret_state": {"group": "appearance", "control": "bool"},
  "caret_extra_width": {"group": "appearance", "control": "number", "range": [0,32], "step": 1, "note": "Add pixels to the caret width."},
  "caret_extra_top": {"group": "appearance", "control": "number", "range": [0,32], "step": 1},
  "caret_extra_bottom": {"group": "appearance", "control": "number", "range": [0,32], "step": 1, "note": "Extend the caret below the line."},
  "show_minimap": {"group": "appearance", "control": "bool", "note": "Show a miniature overview of the document.", "aliases": ["小地图"]},
  "minimap_horizontal_scrolling": {"group": "appearance", "control": "bool", "note": "Scroll the minimap horizontally with the editor."},
  "draw_minimap_border": {"group": "appearance", "control": "bool", "note": "Draw a border around the minimap."},
  "always_show_minimap_viewport": {"group": "appearance", "control": "bool", "note": "Keep the minimap's viewport indicator visible."},
  "minimap_scroll_to_clicked_text": {"group": "appearance", "control": "bool"},
  "show_tabs": {"group": "appearance", "control": "bool", "note": "Display the document tab bar."},
  "enable_tab_scrolling": {"group": "appearance", "control": "bool"},
  "mouse_wheel_switches_tabs": {"group": "appearance", "control": "bool"},
  "hide_new_tab_button": {"group": "appearance", "control": "bool"},
  "hide_tab_scrolling_buttons": {"group": "appearance", "control": "bool", "note": "Hide the arrows for scrolling through tabs."},
  "highlight_modified_tabs": {"group": "appearance", "control": "bool"},
  "show_tab_close_buttons": {"group": "appearance", "control": "bool", "note": "Show a close button on each tab."},
  "show_tab_close_buttons_on_left": {"group": "appearance", "control": "bool"},
  "file_tab_style": {"group": "appearance", "control": "enum", "choices": ["angled","square","rounded"], "note": "Change the shape of document tabs."},
  "show_status_bar": {"group": "appearance", "control": "bool", "note": "Show the status bar below the editor."},
  "show_encoding": {"group": "appearance", "control": "bool"},
  "show_line_endings": {"group": "appearance", "control": "bool", "note": "Show the document's line endings in the status bar."},
  "show_line_column": {"group": "appearance", "control": "enum", "choices": ["enabled","compact","disabled"]},
  "show_full_path": {"group": "appearance", "control": "bool", "note": "Include the full file path in the window title."},
  "show_rel_path": {"group": "appearance", "control": "bool", "note": "Include the project-relative path in the title."},
  "overlay_scroll_bars": {"group": "appearance", "control": "enum", "choices": ["system","enabled","disabled"]},
  "use_simple_full_screen": {"group": "appearance", "control": "bool", "note": "Use a simple full-screen window instead of a macOS Space."},
  "themed_title_bar": {"group": "appearance", "control": "bool", "note": "Apply the theme to the window title bar."},
  "animation_enabled": {"group": "appearance", "control": "bool", "note": "Enable interface animations."},
  "scroll_context_lines": {"group": "appearance", "control": "number", "range": [0,100], "step": 1, "note": "Keep this many context lines near the caret when scrolling."},
  "scroll_speed": {"group": "appearance", "control": "number", "range": [0,10], "step": 0.1, "decimal": true},
  "scroll_past_end": {"group": "appearance", "control": "bool", "note": "Allow scrolling beyond the last line. Edit a fractional distance in JSON."},

  // Geometry and font ranges: editor zoom (6–96), vel-ui/theme.rs (UI font 6–72, scale 0.5–3); other ranges are UI guardrails.
  "font_face": {"group": "fonts", "control": "text", "note": "Editor font family."},
  "font_size": {"group": "fonts", "control": "number", "range": [6,96], "step": 0.5, "decimal": true, "note": "Size of editor text in points.", "aliases": ["type size","字体大小","字号"]},
  "font_options": {"group": "fonts", "control": "array", "note": "Additional editor font flags."},
  "ui_font_face": {"group": "fonts", "control": "text", "name": "UI Font Face"},
  "ui_font_size": {"group": "fonts", "control": "number", "range": [6,72], "step": 0.5, "decimal": true, "note": "Base font size for themed interface text.", "name": "UI Font Size"},
  "ui_scale": {"group": "fonts", "control": "number", "range": [0.5,3], "step": 0.05, "decimal": true, "note": "Scale the interface without changing the editor font.", "name": "UI Scale"},
  "line_padding_top": {"group": "fonts", "control": "number", "range": [-12,100], "step": 0.5, "decimal": true, "note": "Add space above each line of editor text."},
  "line_padding_bottom": {"group": "fonts", "control": "number", "range": [-12,100], "step": 0.5, "decimal": true, "note": "Add space below each line of editor text."},
  "margin": {"group": "fonts", "control": "number", "range": [0,128], "step": 1, "note": "Set the horizontal inset for editor text."},
  "rulers": {"group": "fonts", "control": "array", "note": "Columns at which to draw rulers."},
  "ruler_style": {"group": "fonts", "control": "enum", "choices": ["solid","dotted","stippled"], "note": "Set the line pattern for rulers."},
  "ruler_width": {"group": "fonts", "control": "number", "range": [0.5,8], "step": 0.5, "decimal": true, "note": "Set the stroke width of rulers."},

  // Files and save: docs/settings.md and the Default comments. Policies follow open_requests.rs, vel-session, and vel-fileio.
  "default_encoding": {"group": "files", "control": "text", "note": "Encoding of newly created documents.", "aliases": ["文件编码"]},
  "fallback_encoding": {"group": "files", "control": "text", "aliases": ["编码","character set"]},
  "default_line_ending": {"group": "files", "control": "enum", "choices": ["system","unix","windows"], "note": "Line endings for newly created documents."},
  "default_dir": {"group": "files", "control": "text"},
  "detect_indentation": {"group": "files", "control": "bool"},
  "ensure_newline_at_eof_on_save": {"group": "files", "control": "bool", "note": "Add a final newline when saving."},
  "trim_trailing_white_space_on_save": {"group": "files", "control": "enum", "choices": [false,true,"all","not_on_caret"], "note": "Remove trailing whitespace when saving."},
  "trim_only_modified_white_space": {"group": "files", "control": "bool", "note": "Trim whitespace only on lines changed since the last save.", "show_when": {"trim_trailing_white_space_on_save": [true,"all","not_on_caret"]}},
  "atomic_save": {"group": "files", "control": "bool"},
  "save_on_focus_lost": {"group": "files", "control": "bool"},
  "reload_file_on_change": {"group": "files", "control": "bool", "note": "Automatically reload clean files when they change on disk."},
  "close_deleted_files": {"group": "files", "control": "bool", "note": "Close clean views when their files are deleted."},
  "close_windows_when_empty": {"group": "files", "control": "bool", "note": "Close the window when its last document is closed."},
  "hot_exit": {"group": "files", "control": "enum", "choices": ["always","only_on_quit","disabled",true,false], "note": "Choose when to retain unsaved changes for the next session."},
  "remember_open_files": {"group": "files", "control": "bool", "note": "Restore open files from the previous session."},
  "set_unsaved_view_name": {"group": "files", "control": "bool", "note": "Name untitled tabs from the first line of text."},
  "open_files_in_new_window": {"group": "files", "control": "enum", "choices": ["never","finder_only","always",true,false]},
  "new_window_settings": {"group": "files", "control": "json_only"},
  "update_system_recent_files": {"group": "files", "control": "bool", "note": "Add opened files to the macOS recent documents menu."},
  "image_file_patterns": {"group": "files", "control": "array", "note": "Filename patterns shown in the image viewer."},

  // Find and navigation: docs/settings.md, the Default comments and panels.rs selection-mode reader.
  "find_selected_text": {"group": "find", "control": "bool"},
  "auto_find_in_selection": {"group": "find", "control": "enum", "choices": [false,true,"find_only","replace_only"], "note": "Restrict searches or replacements to the current selection."},
  "close_find_after_find_all": {"group": "find", "control": "bool"},
  "close_find_after_replace_all": {"group": "find", "control": "bool"},
  "regex_auto_escape": {"group": "find", "control": "bool"},
  "binary_file_patterns": {"group": "find", "control": "array"},
  "goto_anything_exclude_gitignore": {"group": "find", "control": "bool", "name": "Goto Anything: Exclude Git-Ignored Files"},

  // File lists and indexing: docs/settings.md, the Default comments and https://www.sublimetext.com/docs/indexing.html#settings.
  "show_side_bar": {"group": "sidebar", "control": "bool", "note": "Show the sidebar with open files and folders.", "aliases": ["sidebar","侧栏"]},
  "file_exclude_patterns": {"group": "sidebar", "control": "array", "note": "File patterns omitted from the sidebar's file tree."},
  "folder_exclude_patterns": {"group": "sidebar", "control": "array", "note": "Folder patterns omitted from the sidebar's file tree."},
  "tree_animation_enabled": {"group": "sidebar", "control": "bool"},
  "preview_on_click": {"group": "sidebar", "control": "enum", "choices": [true,false,"only_left"]},
  "index_files": {"group": "sidebar", "control": "bool", "note": "Build a symbol index of project files."},
  "index_workers": {"group": "sidebar", "control": "number", "range": [0,64], "step": 1, "note": "Index worker count. Zero selects it automatically."},
  "index_exclude_patterns": {"group": "sidebar", "control": "array", "note": "Patterns omitted from the symbol index."},
  "index_include_patterns": {"group": "sidebar", "control": "array", "note": "Restrict symbol indexing to matching patterns when this list is nonempty."},
  "index_exclude_gitignore": {"group": "sidebar", "control": "bool", "note": "Respect Git ignore rules while indexing.", "name": "Index: Exclude Git-Ignored Files"},
  "index_skip_unknown_extensions": {"group": "sidebar", "control": "bool", "note": "Skip files with no known syntax while indexing."},
  "show_definitions": {"group": "sidebar", "control": "bool", "note": "Show definitions or references when hovering over a symbol."},
  "show_git_status": {"group": "sidebar", "control": "bool", "note": "Show Git decorations in the sidebar.", "name": "Show Git Status"},
  "show_git_status_in_status_bar": {"group": "sidebar", "control": "bool", "note": "Show Git branch and status in the status bar.", "name": "Show Git Status in Status Bar"},
  "git_diff_target": {"group": "sidebar", "control": "enum", "choices": ["index","head"], "note": "Choose the Git revision used for inline diffs.", "name": "Git Diff Target"},
  "mini_diff": {"group": "sidebar", "control": "bool", "note": "Show added, changed, and deleted lines in the gutter."},
  "sublime_merge_path": {"group": "sidebar", "control": "text", "note": "Path to the Sublime Merge application."},

  // Build: Default comments and https://www.sublimetext.com/docs/build_systems.html#exec-target-options.
  "show_panel_on_build": {"group": "build", "control": "bool"},
  "save_all_on_build": {"group": "build", "control": "bool"},
  "result_file_regex": {"group": "build", "control": "text", "note": "Match file locations in build output."},
  "result_line_regex": {"group": "build", "control": "text", "note": "Match line locations in build output."},
  "result_base_dir": {"group": "build", "control": "text", "note": "Base directory for relative build result paths."},
  "build_env": {"group": "build", "control": "json_only"},
  "show_errors_inline": {"group": "build", "control": "bool", "note": "Show build diagnostics next to the source line."},

  // Themes and packages: Default comments and the application’s resource readers; installed resource names are not fixed enums.
  "theme": {"group": "packages", "control": "text", "note": "UI theme resource name, or auto to follow appearance."},
  "light_theme": {"group": "packages", "control": "text", "note": "Theme used for light appearance when the theme is automatic."},
  "dark_theme": {"group": "packages", "control": "text", "note": "Theme used for dark appearance when the theme is automatic."},
  "color_scheme": {"group": "packages", "control": "text", "note": "Editor color scheme resource name, or auto to follow appearance."},
  "light_color_scheme": {"group": "packages", "control": "text", "note": "Color scheme used for light appearance when the scheme is automatic."},
  "dark_color_scheme": {"group": "packages", "control": "text", "note": "Color scheme used for dark appearance when the scheme is automatic."},
  "ignored_packages": {"group": "packages", "control": "array"},
  "package_index_url": {"group": "packages", "control": "json_only", "name": "Package Index URL"},

  // Language: docs/i18n.md and the bundled locale inventory. Other installed tags are supported through JSON.
  "ui_language": {"group": "language", "control": "enum", "choices": ["en","zh-Hans","auto"], "aliases": ["locale","语言","简体中文","English"], "name": "UI Language"},
  "spell_check": {"group": "language", "control": "bool", "note": "Check the spelling of text in supported scopes.", "aliases": ["拼写"]},
  "spelling_selector": {"group": "language", "control": "text", "note": "Select the scopes where spell checking applies."},
  "dictionary": {"group": "language", "control": "text", "note": "Dictionary resource used for spell checking."},
  "added_words": {"group": "language", "control": "array", "note": "Add these words to the spelling dictionary."},
  "ignored_words": {"group": "language", "control": "array", "note": "Do not flag these words as spelling errors."},

  // Completion: Default comments and https://www.sublimetext.com/docs/completions.html#settings. Ranking follows vel-complete.
  "auto_complete": {"group": "completion", "control": "bool", "note": "Show suggestions automatically while typing.", "aliases": ["completion","自动补全"]},
  "auto_complete_delay": {"group": "completion", "control": "number", "range": [0,10000], "step": 1, "note": "Delay before automatic suggestions appear, in milliseconds."},
  "auto_complete_size_limit": {"group": "completion", "control": "number", "range": [0,2147483648], "step": 1, "note": "Largest buffer, in bytes, eligible for automatic completion."},
  "auto_complete_selector": {"group": "completion", "control": "text"},
  "default_completions_selector": {"group": "completion", "control": "json_only"},
  "disable_default_completions": {"group": "completion", "control": "bool"},
  "tab_completion": {"group": "completion", "control": "bool"},
  "auto_complete_commit_on_tab": {"group": "completion", "control": "bool", "note": "Commit the selected completion with Tab.", "show_when": {"auto_complete": true}},
  "auto_complete_with_fields": {"group": "completion", "control": "bool", "note": "Show automatic completions inside snippet fields."},
  "auto_complete_cycle": {"group": "completion", "control": "bool", "note": "Cycle through the list when moving past either end."},
  "auto_complete_when_likely": {"group": "completion", "control": "bool", "note": "Offer suggestions when there is a likely match."},
  "auto_complete_use_index": {"group": "completion", "control": "bool", "note": "Include words from the project index."},
  "auto_complete_include_snippets": {"group": "completion", "control": "bool", "note": "Include snippets in completion results."},
  "auto_complete_include_snippets_when_typing": {"group": "completion", "control": "bool"},
  "auto_complete_triggers": {"group": "completion", "control": "array"},
  "auto_complete_preserve_order": {"group": "completion", "control": "enum", "choices": ["none","some","strict",true,false]},
  "auto_complete_use_history": {"group": "completion", "control": "bool"},
  "auto_complete_trailing_symbols": {"group": "completion", "control": "bool"},
  "auto_complete_trailing_spaces": {"group": "completion", "control": "bool"},

  // Large files: Default comments and large.rs/editor.rs. Upper bounds are manual UI guardrails, not file-format limits.
  "large_file.load_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "note": "File size at which to use the large-file loading path, in bytes."},
  "large_file.viewport_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "note": "File size at which highlighting is limited to the viewport, in bytes."},
  "large_file.viewport_lines": {"group": "developer", "control": "number", "range": [0,2147483648], "step": 1, "note": "Line count at which highlighting is limited to the viewport."},
  "large_file.long_line_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "note": "Line length that activates large-file safeguards, in bytes."},
  "large_file.indexing_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "note": "Size threshold for skipping symbol indexing, in bytes."},
  "large_file.wrap_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "note": "Size threshold for disabling automatic wrapping, in bytes."},
  "large_file.spell_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "note": "Size threshold for disabling spell checking, in bytes."},
  "large_file.diff_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "note": "Size threshold for disabling inline diffs, in bytes."},
  "large_file.minimap_lines": {"group": "developer", "control": "number", "range": [0,2147483648], "step": 1, "note": "Line count threshold for disabling the minimap."},
  "large_file.max_line_bytes": {"group": "developer", "control": "number", "range": [1,1048576], "step": 1, "note": "Maximum bytes highlighted on a long line."},
  "large_file.max_viewport_lines": {"group": "developer", "control": "number", "range": [1,16384], "step": 1, "note": "Limit on lines prepared for viewport highlighting."},
  "large_file.max_lookback_lines": {"group": "developer", "control": "number", "range": [1,16384], "step": 1, "note": "Limit on lines scanned before the viewport."},
  "large_file.checkpoint_interval": {"group": "developer", "control": "number", "range": [1,1048576], "step": 1, "note": "Line interval between syntax checkpoints."},
  "large_file.max_checkpoints": {"group": "developer", "control": "number", "range": [1,16384], "step": 1, "note": "Maximum retained syntax checkpoints."},
}
