// Control assignments and authored English copy for general Preferences.
// Only names and descriptions are localized; keys and values are data.
// Numeric bounds apply to the page; JSON still accepts the full runtime domain.
// Mixed-type legacy values remain intact and can be edited in JSON.
// Descriptions name keys and the system through {alt}, {command} and {os}, which read
// Option, Command, macOS on a Mac and Alt, Ctrl, Windows on Windows.
{

  // Editing and Vintage.
  "tab_size": {"group": "editing", "control": "number", "range": [1,32], "step": 1, "aliases": ["indent","制表符宽度","缩进"], "name": "Tab Size", "description": "Spaces represented by a tab."},
  "translate_tabs_to_spaces": {"group": "editing", "control": "bool", "aliases": ["spaces","空格代替制表符"], "name": "Insert Spaces Instead of Tabs", "description": "Insert spaces when you press Tab."},
  "word_wrap": {"group": "editing", "control": "enum", "choices": ["auto",true,false], "aliases": ["wrap","自动换行","换行"], "name": "Word Wrap", "description": "Wrap long lines to fit the editor or a set column."},
  "wrap_width": {"group": "editing", "control": "number", "range": [0,10000], "step": 1, "aliases": ["columns","换行宽度"], "name": "Wrap Width", "description": "Wrap at this column. Zero uses the available width.", "show_when": {"word_wrap": {"not":false}}},
  "wrap_width_style": {"group": "editing", "control": "enum", "choices": ["auto","fixed"], "name": "Wrap Width Style", "description": "Let the wrap column follow the window or stay fixed.", "show_when": {"word_wrap": {"not":false}}},
  "indent_subsequent_lines": {"group": "editing", "control": "bool", "name": "Indent Wrapped Lines", "description": "Keep the original line’s indentation on wrapped lines."},
  "draw_indent_guides": {"group": "editing", "control": "bool", "name": "Indent Guides", "description": "Show a guide for each indentation level."},
  "indent_guide_options": {"group": "editing", "control": "array", "choices": ["draw_normal","draw_active"], "name": "Indent Guide Options", "description": "Choose whether to show all guides or emphasize the active indent.", "show_when": {"draw_indent_guides":true}},
  "auto_indent": {"group": "editing", "control": "bool", "name": "Auto Indent", "description": "Carry the current indentation onto a new line."},
  "smart_indent": {"group": "editing", "control": "bool", "name": "Smart Indent", "description": "Adjust indentation using the current syntax’s rules."},
  "indent_to_bracket": {"group": "editing", "control": "bool", "name": "Indent to Bracket", "description": "Align the next line just after an unmatched opening bracket."},
  "auto_match_enabled": {"group": "editing", "control": "bool", "name": "Auto Pair Brackets and Quotes", "description": "Insert the closing bracket or quote as you type."},
  "auto_close_tags": {"group": "editing", "control": "bool", "name": "Auto Close Tags", "description": "Finish an HTML or XML closing tag as you start typing it."},
  "drag_text": {"group": "editing", "control": "bool", "name": "Drag Selected Text", "description": "Move selected text by dragging. Hold {alt} to copy it."},
  "trim_automatic_white_space": {"group": "editing", "control": "bool", "name": "Trim Auto-Inserted Spaces", "description": "Clear auto-inserted indentation when leaving an empty line."},
  "shift_tab_unindent": {"group": "editing", "control": "bool", "name": "Always Unindent with Shift+Tab", "description": "Let Shift+Tab unindent even outside leading whitespace."},
  "use_tab_stops": {"group": "editing", "control": "bool", "name": "Use Tab Stops", "description": "When indenting with spaces, Tab and Backspace move to tab stops."},
  "copy_with_empty_selection": {"group": "editing", "control": "bool", "name": "Copy or Cut the Current Line", "description": "Copy or cut the entire line when no text is selected."},
  "word_separators": {"group": "editing", "control": "text", "aliases": ["word boundaries","单词分隔符"], "name": "Word Separators", "description": "Set word boundaries for selection and navigation."},
  "sub_word_separators": {"group": "editing", "control": "text", "name": "Subword Separators", "description": "Set extra boundaries for navigation within a word."},
  "move_to_limit_on_up_down": {"group": "editing", "control": "bool", "name": "Arrow Keys Reach Document Ends", "description": "Let Up and Down move to the start or end at the outermost rows."},
  "match_brackets": {"group": "editing", "control": "bool", "name": "Highlight Matching Brackets", "description": "Highlight the bracket paired with the one at the caret."},
  "match_brackets_content": {"group": "editing", "control": "bool", "name": "Highlight Brackets from Within", "description": "Highlight enclosing brackets when the caret is between them."},
  "match_brackets_square": {"group": "editing", "control": "bool", "name": "Match Square Brackets", "description": "Include square brackets in bracket highlighting."},
  "match_brackets_braces": {"group": "editing", "control": "bool", "name": "Match Braces", "description": "Include braces in bracket highlighting."},
  "match_brackets_angle": {"group": "editing", "control": "bool", "name": "Match Angle Brackets", "description": "Include angle brackets in bracket highlighting."},
  "match_tags": {"group": "editing", "control": "bool", "name": "Highlight Matching Tags", "description": "Highlight matching opening and closing markup tags."},
  "vintage_enabled": {"group": "editing", "control": "bool", "name": "Enable Vintage", "description": "Enable Vintage modal editing."},
  "vintage_start_in_command_mode": {"group": "editing", "control": "bool", "name": "Start Vintage in Command Mode", "description": "Enter command mode instead of insert mode when Vintage starts."},
  "vintage_ctrl_keys": {"group": "editing", "control": "enum", "choices": [null,true,false], "labels": ["Platform Default",null,null], "name": "Vintage Ctrl Keys", "description": "Use Vintage Ctrl shortcuts or leave them at the platform default."},
  "vintage_use_clipboard": {"group": "editing", "control": "bool", "name": "Vintage Uses the Clipboard", "description": "Use the system clipboard for the default Vintage register."},

  // Appearance.
  "line_numbers": {"group": "appearance", "control": "bool", "aliases": ["行号"], "name": "Line Numbers", "description": "Show line numbers next to the text."},
  "relative_line_numbers": {"group": "appearance", "control": "bool", "name": "Relative Line Numbers", "description": "Number lines by their distance from the caret."},
  "gutter": {"group": "appearance", "control": "bool", "name": "Editor Gutter", "description": "Show the gutter next to the document."},
  "highlight_line": {"group": "appearance", "control": "bool", "name": "Highlight Current Line", "description": "Highlight the line containing the caret."},
  "highlight_line_number": {"group": "appearance", "control": "bool", "name": "Highlight Current Line Number", "description": "Highlight the line number at the caret."},
  "match_selection": {"group": "appearance", "control": "bool", "name": "Highlight Selection Matches", "description": "Highlight other occurrences of the selected word."},
  "fold_buttons": {"group": "appearance", "control": "bool", "name": "Fold Buttons", "description": "Show fold controls in the gutter."},
  "fade_fold_buttons": {"group": "appearance", "control": "bool", "name": "Show Fold Buttons on Hover", "description": "Hide fold buttons until the pointer is over the gutter."},
  "draw_white_space": {"group": "appearance", "control": "enum", "choices": ["none","selection","leading","trailing","all",null], "labels": ["None","In the Selection","Leading","Trailing","All",null], "aliases": ["空白字符"], "name": "Draw White Space", "description": "Choose where to show marks for spaces and tabs."},
  "draw_unicode_white_space": {"group": "appearance", "control": "enum", "choices": ["none","punctuation","all"], "name": "Show Unicode Whitespace", "description": "Mark Unicode spaces other than ordinary spaces and tabs."},
  "draw_unicode_bidi": {"group": "appearance", "control": "bool", "name": "Show Bidirectional Controls", "description": "Mark invisible characters that change text direction."},
  "draw_control_characters": {"group": "appearance", "control": "bool", "name": "Show Control Characters", "description": "Show marks for invisible control characters."},
  "caret_style": {"group": "appearance", "control": "enum", "choices": ["solid","blink","smooth","phase","block","underline"], "labels": ["Solid","Blink","Smooth","Phase","Block","Underline"], "aliases": ["cursor","光标"], "name": "Caret Style", "description": "Choose how the insertion caret looks or blinks."},
  "block_caret": {"group": "appearance", "control": "bool", "name": "Block Caret", "description": "Use a filled block for the insertion caret."},
  "inverse_caret_state": {"group": "appearance", "control": "bool", "name": "Invert Caret Blink", "description": "Reverse the visible and hidden phases of the caret blink."},
  "caret_extra_width": {"group": "appearance", "control": "number", "range": [0,32], "step": 1, "name": "Extra Caret Width", "description": "Add pixels to the caret width."},
  "caret_extra_top": {"group": "appearance", "control": "number", "range": [0,32], "step": 1, "name": "Extend Caret Above", "description": "Extend the caret above the line by this many pixels."},
  "caret_extra_bottom": {"group": "appearance", "control": "number", "range": [0,32], "step": 1, "name": "Extend Caret Below", "description": "Extend the caret below the line by this many pixels."},
  "show_minimap": {"group": "appearance", "control": "bool", "aliases": ["小地图"], "name": "Show Minimap", "description": "Show a miniature overview of the document."},
  "minimap_horizontal_scrolling": {"group": "appearance", "control": "bool", "name": "Minimap Horizontal Scrolling", "description": "Scroll the minimap horizontally with the editor."},
  "draw_minimap_border": {"group": "appearance", "control": "bool", "name": "Minimap Border", "description": "Outline the minimap with a border."},
  "always_show_minimap_viewport": {"group": "appearance", "control": "bool", "name": "Always Show Minimap Viewport", "description": "Keep the visible portion of the document marked in the minimap."},
  "minimap_scroll_to_clicked_text": {"group": "appearance", "control": "bool", "name": "Minimap Click Position", "description": "Keep clicked text under the pointer instead of centering it."},
  "show_tabs": {"group": "appearance", "control": "bool", "name": "Show Tabs", "description": "Show the document tab bar."},
  "enable_tab_scrolling": {"group": "appearance", "control": "bool", "name": "Scrollable Tab Bar", "description": "Scroll overflowing tabs instead of shrinking them all to fit."},
  "mouse_wheel_switches_tabs": {"group": "appearance", "control": "bool", "name": "Mouse Wheel Switches Tabs", "description": "Switch tabs by wheeling vertically over the tab bar."},
  "hide_new_tab_button": {"group": "appearance", "control": "bool", "name": "Hide New Tab Button", "description": "Hide the new tab button in the tab bar."},
  "hide_tab_scrolling_buttons": {"group": "appearance", "control": "bool", "name": "Hide Tab Scrolling Buttons", "description": "Hide the arrows for scrolling through tabs."},
  "highlight_modified_tabs": {"group": "appearance", "control": "bool", "name": "Highlight Modified Tabs", "description": "Use the theme’s modified label color for unsaved tabs."},
  "show_tab_close_buttons": {"group": "appearance", "control": "bool", "name": "Show Tab Close Buttons", "description": "Show a close button on each tab."},
  "show_tab_close_buttons_on_left": {"group": "appearance", "control": "bool", "name": "Tab Close Buttons on Left", "description": "Move close buttons and unsaved markers to the left."},
  "file_tab_style": {"group": "appearance", "control": "enum", "choices": ["angled","square","rounded"], "labels": ["Angled","Square","Rounded"], "name": "File Tab Style", "description": "Choose the shape of document tabs."},
  "show_status_bar": {"group": "appearance", "control": "bool", "name": "Show Status Bar", "description": "Show the status bar below the editor."},
  "show_encoding": {"group": "appearance", "control": "bool", "name": "Show Encoding", "description": "Show the document’s encoding in the status bar."},
  "show_line_endings": {"group": "appearance", "control": "bool", "name": "Show Line Endings", "description": "Show the document’s line ending format in the status bar."},
  "show_syntax": {"group": "appearance", "control": "bool", "name": "Show Syntax", "description": "Show the document’s syntax or binary label in the status bar."},
  "show_indentation": {"group": "appearance", "control": "bool", "name": "Show Indentation", "description": "Show the document’s indentation style and tab width in the status bar."},
  "show_sidebar_button": {"group": "appearance", "control": "bool", "name": "Show Sidebar and Panels Button", "description": "Show the sidebar and panel switcher in the status bar."},
  "show_line_column": {"group": "appearance", "control": "enum", "choices": ["enabled","compact","disabled"], "name": "Show Line and Column", "description": "Show the caret’s line and column in full, in brief, or not at all."},
  "show_full_path": {"group": "appearance", "control": "bool", "name": "Show Full Path in Title", "description": "Include the file’s full path in the window title."},
  "show_rel_path": {"group": "appearance", "control": "bool", "name": "Show Relative Path in Title", "description": "Include the path relative to the project in the window title."},
  "overlay_scroll_bars": {"group": "appearance", "control": "enum", "choices": ["system","enabled","disabled"], "labels": ["System Setting","Always Overlay","Never Overlay"], "name": "Overlay Scroll Bars", "description": "Overlay the editor, reserve space, or follow {os}."},
  "use_simple_full_screen": {"group": "appearance", "control": "bool", "name": "Simple Full Screen", "description": "Go full screen without creating a separate macOS Space."},
  "themed_title_bar": {"group": "appearance", "control": "bool", "name": "Themed Title Bar", "description": "Apply the selected theme to the window title bar."},
  "animation_enabled": {"group": "appearance", "control": "bool", "name": "Interface Animations", "description": "Animate interface transitions unless Reduce Motion is on."},
  "scroll_context_lines": {"group": "appearance", "control": "number", "range": [0,100], "step": 1, "name": "Scroll Context Lines", "description": "Keep this many lines of context when scrolling the caret into view."},
  "scroll_speed": {"group": "appearance", "control": "number", "range": [0,10], "step": 0.1, "decimal": true, "name": "Scroll Speed", "description": "Scale the distance moved by each scroll gesture."},
  "scroll_past_end": {"group": "appearance", "control": "bool", "name": "Scroll Past End", "description": "Allow scrolling beyond the last line."},

  // Editor and interface typography.
  "font_face": {"group": "fonts", "control": "text", "name": "Font Face", "description": "Choose the editor’s font family."},
  "font_size": {"group": "fonts", "control": "number", "range": [6,96], "step": 0.5, "decimal": true, "aliases": ["type size","字体大小","字号"], "name": "Font Size", "description": "Size of editor text in points."},
  "font_options": {"group": "fonts", "control": "array", "name": "Font Options", "description": "Set rendering options for editor text, such as ligatures."},
  "ui_font_face": {"group": "fonts", "control": "text", "name": "UI Font Face", "description": "Override the theme’s interface font family."},
  "ui_font_size": {"group": "fonts", "control": "number", "range": [6,72], "step": 0.5, "decimal": true, "name": "UI Font Size", "description": "Set the base font size for interface text."},
  "ui_scale": {"group": "fonts", "control": "number", "range": [0.5,3], "step": 0.05, "decimal": true, "name": "UI Scale", "description": "Scale the interface without changing the editor font."},
  "line_padding_top": {"group": "fonts", "control": "number", "range": [-12,100], "step": 0.5, "decimal": true, "name": "Line Padding Above", "description": "Add space above each line of editor text."},
  "line_padding_bottom": {"group": "fonts", "control": "number", "range": [-12,100], "step": 0.5, "decimal": true, "name": "Line Padding Below", "description": "Add space below each line of editor text."},
  "margin": {"group": "fonts", "control": "number", "range": [0,128], "step": 1, "name": "Editor Margin", "description": "Set the space between the gutter and the text."},
  "rulers": {"group": "fonts", "control": "array", "name": "Column Guides", "description": "Draw vertical guides at the specified columns."},
  "ruler_style": {"group": "fonts", "control": "enum", "choices": ["solid","dotted","stippled"], "name": "Column Guide Style", "description": "Choose the line pattern for column guides."},
  "ruler_width": {"group": "fonts", "control": "number", "range": [0.5,8], "step": 0.5, "decimal": true, "name": "Column Guide Width", "description": "Set the thickness of column guides."},

  // Files and Encoding.
  "default_encoding": {"group": "files", "control": "text", "aliases": ["文件编码"], "name": "Default Encoding", "description": "Set the initial encoding of new documents."},
  "fallback_encoding": {"group": "files", "control": "text", "aliases": ["编码","character set"], "name": "Fallback Encoding", "description": "Try this encoding when a file cannot be decoded as UTF-8."},
  "default_line_ending": {"group": "files", "control": "enum", "choices": ["system","unix","windows"], "labels": ["System Default","Unix (LF)","Windows (CRLF)"], "name": "Default Line Ending", "description": "Set the line ending format for new documents."},
  "default_dir": {"group": "files", "control": "text", "name": "Default Save Directory", "description": "Set the initial directory for the save dialog."},
  "detect_indentation": {"group": "files", "control": "bool", "name": "Detect Indentation", "description": "Detect tabs or spaces and indentation width when opening a file."},
  "ensure_newline_at_eof_on_save": {"group": "files", "control": "bool", "name": "Add Final Newline on Save", "description": "Add a final newline when saving a file."},
  "trim_trailing_white_space_on_save": {"group": "files", "control": "enum", "choices": [false,true,"all","not_on_caret"], "labels": [null,null,"All Lines","All Lines Except the Caret Line"], "name": "Trim Trailing Whitespace on Save", "description": "Remove trailing whitespace when saving a file."},
  "trim_only_modified_white_space": {"group": "files", "control": "bool", "name": "Trim Only Modified Lines", "description": "Trim whitespace only on lines changed since the last save.", "show_when": {"trim_trailing_white_space_on_save":[true,"all","not_on_caret"]}},
  "atomic_save": {"group": "files", "control": "bool", "name": "Atomic Save", "description": "Write to a temporary file and replace the original when possible."},
  "save_on_focus_lost": {"group": "files", "control": "bool", "name": "Save on Focus Loss", "description": "Save modified files when the tab or window loses focus."},
  "reload_file_on_change": {"group": "files", "control": "bool", "name": "Reload Changed Files", "description": "Reload unmodified documents when the file changes on disk."},
  "reload_file_in_background": {"group": "files", "control": "bool", "name": "Reload Files in Background", "description": "Reload unmodified inactive documents without waiting for activation."},
  "close_deleted_files": {"group": "files", "control": "bool", "name": "Close Deleted Files", "description": "Close unmodified documents whose files are deleted from disk."},
  "close_windows_when_empty": {"group": "files", "control": "bool", "name": "Close Empty Windows", "description": "Close a window when you close its last document, unless it has folders or a saved project."},
  "hot_exit": {"group": "files", "control": "enum", "choices": ["always","only_on_quit","disabled",true,false], "labels": ["Always","Only When Quitting","Never",null,null], "name": "Hot Exit", "description": "Choose when to keep unsaved edits for the next session."},
  "remember_open_files": {"group": "files", "control": "bool", "name": "Remember Open Files", "description": "Restore open files from the previous session."},
  "update_check": {"group": "general", "control": "bool", "name": "Automatically Check for Updates", "description": "Check GitHub for new stable Velocity releases once a day. Manual checks are always available."},
  "set_unsaved_view_name": {"group": "files", "control": "bool", "name": "Name Untitled Tabs from Text", "description": "Use the first line of text to name untitled tabs."},
  "open_files_in_new_window": {"group": "files", "control": "enum", "choices": ["never","finder_only","always",true,false], "labels": ["Never","Only from {file_manager}","Always",null,null], "name": "Open Files in New Window", "description": "Choose when opening a file creates a new window."},
  "new_window_settings": {"group": "files", "control": "json_only", "name": "New Window Settings", "description": "Override preferences for windows created with New Window."},
  "update_system_recent_files": {"group": "files", "control": "bool", "name": "Update System Recent Files", "description": "Add opened files to the {os} recent documents list."},
  "image_file_patterns": {"group": "files", "control": "array", "name": "Image File Patterns", "description": "Open matching files in the image viewer."},

  // Find and navigation.
  "find_selected_text": {"group": "find", "control": "bool", "name": "Find Selected Text", "description": "Fill the Find field from a single-line selection."},
  "auto_find_in_selection": {"group": "find", "control": "enum", "choices": [false,true,"find_only","replace_only"], "labels": [null,"Find and Replace","Find Only","Replace Only"], "name": "Auto Find in Selection", "description": "Limit Find or Replace to a multiline selection when opening the panel."},
  "close_find_after_find_all": {"group": "find", "control": "bool", "name": "Close Find after Find All", "description": "Close the Find panel after Find All."},
  "close_find_after_replace_all": {"group": "find", "control": "bool", "name": "Close Replace after Replace All", "description": "Close the Replace panel after Replace All."},
  "regex_auto_escape": {"group": "find", "control": "bool", "name": "Escape Selection in Regex Search", "description": "Escape regex characters when filling the Find field from a selection."},
  "highlight_find_results_in_scrollbar": {"group":"find","control":"bool","name":"Mark Find Matches in Scrollbar","description":"Show match marks in the scrollbar or minimap gutter."},
  "find_scroll_highlights_limit": {"group":"find","control":"number","range":[0,2147483648],"step":1,"name":"Find Scrollbar Match Limit","description":"Hide scrollbar marks above this match count. Zero removes the limit."},
  "find_highlight_matches_max_size": {"group":"find","control":"number","range":[0,1099511627776],"step":1,"name":"Find Highlight File Size Limit","description":"Skip automatic literal match highlighting above this many bytes. Zero removes the limit."},
  "find_regex_highlight_matches_max_size": {"group":"find","control":"number","range":[0,1099511627776],"step":1,"name":"Regex Find Highlight File Size Limit","description":"Skip automatic regex match highlighting above this many bytes. Zero removes the limit."},
  "use_find_clipboard": {"group":"find","control":"bool","name":"Use System Find Pasteboard","description":"Share the Find string on focus and when copying a selection to Find on macOS."},
  "find_in_files_max_file_size": {"group":"find","control":"number","range":[0,1099511627776],"step":1,"name":"Find in Files Input Size Limit","description":"Skip files larger than this many bytes. Zero removes the limit."},
  "find_in_files_max_result_size": {"group":"find","control":"number","range":[0,1099511627776],"step":1,"name":"Find in Files Output Size Limit","description":"Limit the displayed result bytes. Zero removes the limit; replacements still include hidden matches."},
  "find_in_files_context_characters": {"group":"find","control":"number","range":[0,2147483648],"step":1,"name":"Find in Files Context Characters","description":"Limit characters per result line. Zero keeps the standard preview."},
  "find_in_files_context_lines": {"group":"find","control":"number","range":[0,100],"step":1,"name":"Find in Files Context Lines","description":"Set how many lines appear before and after each match when Context is on."},
  "console_max_history_lines": {"group":"developer","control":"number","range":[0,2147483648],"step":1,"name":"Console History Lines","description":"Keep at most this many recent diagnostic lines. Zero disables history."},
  "find_in_files_suppress_errors": {"group":"find","control":"bool","name":"Hide Find in Files Errors","description":"Hide file access and traversal errors in search results."},
  "find_in_files_side_by_side": {"group":"find","control":"bool","name":"Open Matches Beside Find Results","description":"Keep the Find Results tab visible beside the file opened from a match."},
  "io_workers": {"group":"files","control":"number","range":[0,64],"step":1,"name":"File Read and Write Workers","description":"Limit concurrent document reads and writes per window. Zero keeps standard scheduling."},
  "syntax_detection_size_limit": {"group":"files","control":"number","range":[0,1099511627776],"step":1,"name":"Automatic Syntax Detection Size Limit","description":"Skip automatic syntax detection above this many bytes. Zero removes the limit."},
  "binary_file_patterns": {"group": "find", "control": "array", "name": "Binary File Patterns", "description": "Treat matching files as binary when listing files for navigation or search."},
  "goto_anything_exclude_gitignore": {"group": "find", "control": "bool", "name": "Goto Anything: Exclude Git-Ignored Files", "description": "Omit Git-ignored files from Goto Anything."},

  // File lists and indexing.
  "show_side_bar": {"group": "sidebar", "control": "enum", "choices": ["auto",true,false], "labels": ["When the Window Has Folders","Always","Never"], "aliases": ["sidebar","侧栏"], "name": "Show Sidebar", "description": "Auto shows the sidebar only while the window has folders. Set true or false in User settings to override this default. A window's own sidebar toggle takes precedence and survives session restore."},
  "file_exclude_patterns": {"group": "sidebar", "control": "array", "name": "File Exclude Patterns", "description": "Omit matching files from the sidebar’s file tree."},
  "folder_exclude_patterns": {"group": "sidebar", "control": "array", "name": "Folder Exclude Patterns", "description": "Omit matching folders from the sidebar’s file tree."},
  "tree_animation_enabled": {"group": "sidebar", "control": "bool", "name": "Sidebar Tree Animations", "description": "Animate changes in the sidebar’s file tree."},
  "preview_on_click": {"group": "sidebar", "control": "enum", "choices": [true,false,"only_left"], "labels": [null,null,"Left Click Only"], "name": "Preview on Click", "description": "Choose which clicks preview a file from the sidebar."},
  "index_files": {"group": "sidebar", "control": "bool", "name": "Index Files", "description": "Build a symbol index of project files."},
  "index_workers": {"group": "sidebar", "control": "number", "range": [0,64], "step": 1, "name": "Index Workers", "description": "Set the number of index workers. Zero chooses automatically."},
  "index_exclude_patterns": {"group": "sidebar", "control": "array", "name": "Index Exclude Patterns", "description": "Skip matching files when building the symbol index."},
  "index_include_patterns": {"group": "sidebar", "control": "array", "name": "Index Include Patterns", "description": "When the list is nonempty, index only matching files."},
  "index_exclude_gitignore": {"group": "sidebar", "control": "bool", "name": "Index: Exclude Git-Ignored Files", "description": "Respect Git ignore rules when building the symbol index."},
  "index_skip_unknown_extensions": {"group": "sidebar", "control": "bool", "name": "Index: Skip Unknown Extensions", "description": "Skip files with no known syntax when indexing."},
  "show_definitions": {"group": "sidebar", "control": "bool", "name": "Show Definitions", "description": "Show definitions or references when hovering over a symbol."},
  "show_git_status": {"group": "sidebar", "control": "bool", "name": "Show Git Status", "description": "Show Git status indicators in the sidebar."},
  "show_git_status_in_status_bar": {"group": "sidebar", "control": "bool", "name": "Show Git Status in Status Bar", "description": "Show the Git branch and status in the status bar."},
  "git_diff_target": {"group": "sidebar", "control": "enum", "choices": ["index","head"], "name": "Git Diff Target", "description": "Compare changes against the Git index or HEAD."},
  "mini_diff": {"group": "sidebar", "control": "bool", "name": "Inline Diff Markers", "description": "Mark added, changed, and deleted lines in the gutter."},
  "sublime_merge_path": {"group": "sidebar", "control": "text", "name": "Sublime Merge Location", "description": "Choose the location of the Sublime Merge application."},

  // Build systems.
  "show_panel_on_build": {"group": "build", "control": "bool", "name": "Show Build Output", "description": "Show the output panel when a build starts."},
  "save_all_on_build": {"group": "build", "control": "bool", "name": "Save Files Before Build", "description": "Save all modified named files before running a build."},
  "result_file_regex": {"group": "build", "control": "text", "name": "Build Result File Pattern", "description": "Match file names and locations in build output."},
  "result_line_regex": {"group": "build", "control": "text", "name": "Build Result Line Pattern", "description": "Match line locations in multiline build output."},
  "result_base_dir": {"group": "build", "control": "text", "name": "Build Result Base Directory", "description": "Resolve relative file names in build results from this directory."},
  "build_env": {"group": "build", "control": "json_only", "name": "Build Environment", "description": "Set environment variables shared by build systems."},
  "show_errors_inline": {"group": "build", "control": "bool", "name": "Show Inline Build Errors", "description": "Show build diagnostics next to the relevant source line."},

  // Themes and packages.
  "theme": {"group": "packages", "control": "text", "name": "Theme", "description": "Choose an interface theme or follow the system appearance."},
  "light_theme": {"group": "packages", "control": "text", "name": "Light Theme", "description": "Use this theme in light mode when Theme is automatic."},
  "dark_theme": {"group": "packages", "control": "text", "name": "Dark Theme", "description": "Use this theme in dark mode when Theme is automatic."},
  "color_scheme": {"group": "packages", "control": "text", "name": "Color Scheme", "description": "Choose an editor color scheme or follow the system appearance."},
  "light_color_scheme": {"group": "packages", "control": "text", "name": "Light Color Scheme", "description": "Use this scheme in light mode when Color Scheme is automatic."},
  "dark_color_scheme": {"group": "packages", "control": "text", "name": "Dark Color Scheme", "description": "Use this scheme in dark mode when Color Scheme is automatic."},
  "ignored_packages": {"group": "packages", "control": "array", "name": "Ignored Packages", "description": "Disable the packages in this list."},
  "package_index_url": {"group": "packages", "control": "json_only", "name": "Package Index URL", "description": "Choose the address used to look up packages."},

  // Language and spelling.
  "ui_language": {"group": "language", "control": "enum", "choices": ["en","zh-Hans","auto"], "aliases": ["locale","语言","简体中文","English"], "name": "UI Language", "description": "Choose a language or follow the first supported {os} preferred language."},
  "spell_check": {"group": "language", "control": "bool", "aliases": ["拼写"], "name": "Spell Check", "description": "Check spelling in supported parts of a document."},
  "spelling_selector": {"group": "language", "control": "text", "name": "Spelling Scope Selector", "description": "Choose the syntax scopes to check for spelling mistakes."},
  "dictionary": {"group": "language", "control": "text", "name": "Dictionary", "description": "Choose the dictionary resource used for spell checking."},
  "added_words": {"group": "language", "control": "array", "name": "Added Words", "description": "Treat these extra words as valid spellings."},
  "ignored_words": {"group": "language", "control": "array", "name": "Ignored Words", "description": "Do not flag these words as spelling errors."},

  // Completions.
  "auto_complete": {"group": "completion", "control": "bool", "aliases": ["completion","自动补全"], "name": "Auto Complete", "description": "Show suggestions automatically while typing."},
  "auto_complete_delay": {"group": "completion", "control": "number", "range": [0,10000], "step": 1, "name": "Auto Complete Delay", "description": "Wait this many milliseconds before showing automatic suggestions."},
  "auto_complete_size_limit": {"group": "completion", "control": "number", "range": [0,2147483648], "step": 1, "name": "Auto Complete Size Limit", "description": "Set the largest document size, in bytes, for automatic suggestions."},
  "auto_complete_selector": {"group": "completion", "control": "text", "name": "Auto Complete Scope Selector", "description": "Choose where automatic suggestions can appear."},
  "default_completions_selector": {"group": "completion", "control": "json_only", "name": "Built-in Completion Scopes", "description": "Select where built-in HTML and CSS suggestions are offered."},
  "disable_default_completions": {"group": "completion", "control": "bool", "name": "Disable Built-in Completions", "description": "Hide built-in HTML and CSS suggestions without hiding user snippets."},
  "tab_completion": {"group": "completion", "control": "bool", "name": "Tab Completion", "description": "Let Tab complete the word at the caret, not just exact snippet triggers."},
  "auto_complete_commit_on_tab": {"group": "completion", "control": "bool", "name": "Accept Completion with Tab", "description": "Insert the highlighted suggestion when you press Tab.", "show_when": {"auto_complete":true}},
  "auto_complete_with_fields": {"group": "completion", "control": "bool", "name": "Suggest in Snippet Fields", "description": "Show automatic suggestions inside snippet fields."},
  "auto_complete_cycle": {"group": "completion", "control": "bool", "name": "Cycle Through Suggestions", "description": "Wrap from either end of the suggestion list to the other."},
  "auto_complete_when_likely": {"group": "completion", "control": "bool", "name": "Suggest Likely Matches", "description": "Offer automatic suggestions where a completion is likely."},
  "auto_complete_use_index": {"group": "completion", "control": "bool", "name": "Complete from Index", "description": "Include words from the project index in suggestions."},
  "auto_complete_include_snippets": {"group": "completion", "control": "bool", "name": "Suggest Snippets", "description": "Include snippets in completion results."},
  "auto_complete_include_snippets_when_typing": {"group": "completion", "control": "bool", "name": "Suggest Snippets While Typing", "description": "Include snippets in automatic suggestions as you type."},
  "auto_complete_triggers": {"group": "completion", "control": "array", "name": "Extra Completion Triggers", "description": "Add scopes and characters that open automatic suggestions."},
  "auto_complete_preserve_order": {"group": "completion", "control": "enum", "choices": ["none","some","strict",true,false], "name": "Completion Ordering", "description": "Choose how much of the original suggestion order to preserve."},
  "auto_complete_use_history": {"group": "completion", "control": "bool", "name": "Rank Completions by History", "description": "Rank suggestions using your previous completion choices."},
  "auto_complete_trailing_symbols": {"group": "completion", "control": "bool", "name": "Complete Trailing Symbols", "description": "Suggest punctuation that usually follows the completed word."},
  "auto_complete_trailing_spaces": {"group": "completion", "control": "bool", "name": "Complete Trailing Spaces", "description": "Suggest a trailing space based on other uses of the completed word."},

  // Large-file limits.
  "large_file.load_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "name": "Large File Loading Threshold", "description": "Use large-file loading for files at or above this size in bytes."},
  "large_file.viewport_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "name": "Viewport Highlighting Size Threshold", "description": "Limit highlighting to the visible area at this file size in bytes."},
  "large_file.viewport_lines": {"group": "developer", "control": "number", "range": [0,2147483648], "step": 1, "name": "Viewport Highlighting Line Threshold", "description": "Limit highlighting to the visible area at this document line count."},
  "large_file.long_line_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "name": "Long Line Threshold", "description": "Enable large-file safeguards when a line reaches this length in bytes."},
  "large_file.indexing_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "name": "Indexing Size Limit", "description": "Skip indexing files at or above this size in bytes."},
  "large_file.wrap_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "name": "Word Wrap Size Limit", "description": "Disable automatic wrapping at this file size in bytes."},
  "large_file.spell_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "name": "Spell Check Size Limit", "description": "Disable spell checking at this file size in bytes."},
  "large_file.diff_bytes": {"group": "developer", "control": "number", "range": [0,1099511627776], "step": 1, "name": "Inline Diff Size Limit", "description": "Disable inline diff markers at this file size in bytes."},
  "large_file.minimap_lines": {"group": "developer", "control": "number", "range": [0,2147483648], "step": 1, "name": "Minimap Line Limit", "description": "Hide the minimap when the document reaches this many lines."},
  "large_file.max_line_bytes": {"group": "developer", "control": "number", "range": [1,1048576], "step": 1, "name": "Maximum Highlighted Line Bytes", "description": "Limit how many bytes of a long line are syntax-highlighted."},
  "large_file.max_viewport_lines": {"group": "developer", "control": "number", "range": [1,16384], "step": 1, "name": "Maximum Highlighted Viewport Lines", "description": "Limit how many visible lines are prepared for syntax highlighting."},
  "large_file.max_lookback_lines": {"group": "developer", "control": "number", "range": [1,16384], "step": 1, "name": "Maximum Highlighting Lookback Lines", "description": "Limit how far above the visible area syntax highlighting can scan."},
  "large_file.checkpoint_interval": {"group": "developer", "control": "number", "range": [1,1048576], "step": 1, "name": "Syntax Checkpoint Interval", "description": "Set the number of lines between cached syntax checkpoints."},
  "large_file.max_checkpoints": {"group": "developer", "control": "number", "range": [1,16384], "step": 1, "name": "Maximum Syntax Checkpoints", "description": "Limit how many syntax checkpoints are kept."},

  // Tabs, window chrome, display, sessions and external actions.
  "open_tabs_after_current": {"group": "files", "control": "bool", "name": "Open Tabs After Current", "description": "Insert new tabs immediately after the focused tab instead of at the end."},
  "select_across_groups": {"group": "sidebar", "control": "bool", "name": "Select Across Groups", "description": "Allow selecting a single sidebar file to focus an existing tab in another group."},
  "sidebar_on_right": {"group": "sidebar", "control": "bool", "name": "Sidebar on Right", "description": "Place the sidebar on the right side of the window."},
  "auto_hide_tabs": {"group": "appearance", "control": "bool", "name": "Auto-Hide Tabs", "description": "Hide the tab bar while typing in the editor; show it again on pointer activity."},
  "auto_hide_status_bar": {"group": "appearance", "control": "bool", "name": "Auto-Hide Status Bar", "description": "Hide the status bar while typing in the editor; show it again on pointer activity."},
  "show_project_first": {"group": "appearance", "control": "bool", "name": "Project Name First", "description": "Put the project name before the file name in the window title."},
  "click_through": {"group": "appearance", "control": "bool", "name": "Click Through Inactive Windows", "description": "Let the first click also act in a Velocity window it activates on macOS."},
  "hide_pointer_while_typing": {"group": "appearance", "control": "bool", "name": "Hide Pointer While Typing", "description": "Hide the mouse pointer after typing in the editor until it moves."},
  "set_unsaved_view_name_for_syntax": {"group": "files", "control": "bool", "name": "Name Unsaved Syntax Tabs", "description": "Allow automatic first-line titles in unsaved buffers with a syntax other than plain text."},
  "selection_description_column_type": {"group": "appearance", "control": "enum", "choices": ["display","character","utf16","byte"], "name": "Status Bar Column Units", "description": "Count tab-expanded columns, characters, UTF-16 units, or bytes in the status bar."},
  "highlight_gutter": {"group": "appearance", "control": "bool", "name": "Highlight Gutter", "description": "Highlight the gutter beside the rows containing a caret."},
  "control_character_style": {"group": "appearance", "control": "enum", "choices": ["hex","name","caret"], "name": "Control Character Style", "description": "Label control characters with hexadecimal values, names, or caret notation."},
  "fold_style": {"group": "editing", "control": "enum", "choices": ["auto","indentation"], "name": "Code Folding Style", "description": "Use syntax-aware folds with indentation fallback, or use indentation only."},
  "fold_include_trailing_newline": {"group": "editing", "control": "bool", "name": "Include Trailing Newline in Folds", "description": "Include the final line break when collapsing a syntax-based fold."},
  "hot_exit_projects": {"group": "files", "control": "bool", "name": "Project Hot Exit", "description": "Allow project workspace files to retain unsaved changes under the Hot Exit policy."},
  "remember_layout": {"group": "files", "control": "enum", "choices": ["auto",true,false], "name": "Remember Pane Layout", "description": "Restore pane splits with Hot Exit by default, or explicitly enable or disable remembering splits."},
  "terminal_command": {"group": "files", "control": "array", "name": "External Terminal Command", "description": "Set an executable and arguments for Open Terminal. An empty list uses macOS Terminal."},
  "goto_anything_file_preview": {"group": "find", "control": "bool", "name": "Goto Anything File Preview", "description": "Preview file results before accepting a selection in Goto Anything."},
}
