// Velocity resources, authored from public behavior documentation.
{
  "tab_size": 4,
  "translate_tabs_to_spaces": false,
  "font_face": "Menlo",
  "font_size": 13,
  "line_numbers": true,
  "gutter": true,
  // Public settings reference (https://sublime-text-unofficial-documentation.readthedocs.io/en/latest/reference/settings.html): selection by default.
  "draw_white_space": ["selection"],
  // Drag selected text with the mouse to move it; hold Option when releasing to copy.
  "drag_text": true,
  // Pressing Enter on a line that only holds indentation leaves it empty.
  "trim_automatic_white_space": true,
  // Enter keeps the indentation of the current line.
  "auto_indent": true,
  // Treat these characters as additional boundaries for sub-word commands.
  "sub_word_separators": "_",
  // Null uses the built-in scopes for HTML and CSS completions.
  "default_completions_selector": null,
  // Suppress built-in HTML and CSS completions without hiding user snippets.
  "disable_default_completions": false,
  // With auto_indent, the syntax's indentation rules add or remove a level.
  "smart_indent": true,
  // Tab completes the word before the caret; false limits Tab to exact snippet triggers.
  "tab_completion": true,
  // shift+tab unindents everywhere instead of only in leading white space or across lines.
  "shift_tab_unindent": false,
  // With spaces, Tab and Backspace go to the next / previous tab stop.
  "use_tab_stops": true,
  // Copy and cut with no selection take the whole caret line.
  "copy_with_empty_selection": true,
  // Characters that end a word for double click, word motions and super+d.
  "word_separators": "./\\()\"'-:,.;<>~!@#$%^&*|+=[]{}`~?",
  "ensure_newline_at_eof_on_save": false,
  "trim_trailing_white_space_on_save": false,
  // Build 4107: https://www.sublimetext.com/download
  "trim_only_modified_white_space": true,
  // "system" (LF on macOS), "unix" or "windows".
  "default_line_ending": "system",
  "default_encoding": "UTF-8",
  "fallback_encoding": "Western (Windows 1252)",
  // Build 4107: opt out to ask before replacing even an unchanged buffer.
  // https://www.sublimetext.com/download
  "reload_file_on_change": true,
  "caret_style": "solid",
  // Public settings reference: https://sublime-text-unofficial-documentation.readthedocs.io/en/latest/reference/settings.html#visual-settings
  "highlight_line": false,
  "auto_match_enabled": true,
  // Write through a temporary file and rename it over the original. Even when true, files with
  // hard links, another owner, or metadata that cannot be preserved are saved in place.
  // In-place saves keep a rollback clone or a full staged revision for recovery.
  "atomic_save": false,
  // https://docs.sublimetext.io/reference/settings.html#global-settings
  // User arrays replace this list, including the .git exclusion.
  "folder_exclude_patterns": [
    ".svn", ".git", ".hg", "CVS", ".Trash", ".Trash-*"
  ],
  "file_exclude_patterns": [
    "*.pyc", "*.pyo", "*.exe", "*.dll", "*.obj", "*.o", "*.a", "*.lib",
    "*.so", "*.dylib", "*.ncb", "*.sdf", "*.suo", "*.pdb", "*.idb", ".DS_Store",
    "*.class", "*.psd", "*.db", "*.sublime-workspace", ".velocity-save-*"
  ],
  "show_side_bar": true,
  "color_scheme": "auto",
  "dark_color_scheme": "Velocity Dark.sublime-color-scheme",
  "light_color_scheme": "Velocity Light.sublime-color-scheme",
  "detect_indentation": true,
  "word_wrap": "auto",
  "wrap_width": 0,
  "wrap_width_style": "auto",
  "indent_subsequent_lines": true,
  "draw_indent_guides": true,
  // Active guides disabled by default: https://www.sublimetext.com/updates/2/stable/release_notes.html
  "indent_guide_options": ["draw_normal"],
  // Public settings reference (Visual Settings): other selected-word occurrences.
  "match_selection": true,
  "caret_extra_width": 0,
  "line_padding_top": 0,
  "line_padding_bottom": 0,
  "scroll_context_lines": 3,
  "relative_line_numbers": false,
  "margin": 8,
  "match_brackets": true,
  "match_brackets_content": true,
  "match_brackets_square": true,
  "match_brackets_braces": true,
  "match_brackets_angle": false,
  "match_tags": true,
  "fold_buttons": true,
  "fade_fold_buttons": true,
  // Lane B: drawing, font and window preferences.
  "font_options": [],
  "rulers": [],
  "ruler_style": "solid",
  "ruler_width": 1.0,
  // Build 4107: https://www.sublimetext.com/download
  "scroll_past_end": false,
  "show_minimap": true,
  "show_tabs": true,
  "show_status_bar": true,
  "minimap_horizontal_scrolling": false,
  "draw_minimap_border": false,
  // Visible default change; Visual Settings documents false (hover reveals it).
  // https://docs.sublimetext.io/reference/settings.html#visual-settings
  "always_show_minimap_viewport": false,
  "use_simple_full_screen": false,
  // Lane B round 18: display, tabs, window chrome and builds.
  // Current reference: https://docs.sublimetext.io/reference/settings.html
  // Detailed reference (same documentation project, archived):
  // https://sublime-text-unofficial-documentation.readthedocs.io/en/latest/reference/settings.html
  // Unspecified ST4 defaults retain Velocity's existing behavior.
  // A filled insertion caret, independent of the blink style.
  "block_caret": false,
  // Extra caret height above and below the text line.
  "caret_extra_top": 0,
  "caret_extra_bottom": 0,
  // Reverse the caret's visible blink phase.
  "inverse_caret_state": false,
  // Highlight caret-line numbers with the scheme's highlighted gutter color.
  "highlight_line_number": false,
  // Keep clicked minimap text under the pointer instead of centering it.
  "minimap_scroll_to_clicked_text": false,
  // Use the theme's dirty-tab label color.
  "highlight_modified_tabs": false,
  // Scroll overflowing tabs; false fits all tabs into the strip.
  "enable_tab_scrolling": true,
  // Hide theme-provided tab-strip controls.
  "hide_new_tab_button": false,
  "hide_tab_scrolling_buttons": false,
  // macOS keeps basename titles unless a path option is enabled.
  "show_full_path": false,
  "show_rel_path": false,
  // Preview a sidebar file on one click; false selects it, and "only_left" restricts previews to left clicks.
  "preview_on_click": true,
  // Reveal output when a build starts.
  "show_panel_on_build": true,
  // Save dirty named files before invoking a build.
  "save_all_on_build": true,
  // "enabled" spells out the position; "compact" retains today's abbreviated item; "disabled" hides it.
  "show_line_column": "compact",
  // Animate folder rows unless Reduce Motion is enabled.
  "tree_animation_enabled": true,
  // Keyboard scroll animation speed; zero jumps immediately. Pointer scrolling stays direct.
  "scroll_speed": 1.0,
  // Search omits these binary names while the sidebar continues to list them.
  "binary_file_patterns": ["*.jpg", "*.jpeg", "*.png", "*.gif", "*.ttf", "*.tga", "*.dds", "*.ico", "*.eot", "*.pdf", "*.swf", "*.jar", "*.zip"],
  "hot_exit": "always",
  "remember_open_files": true,
  "close_windows_when_empty": false,
  "close_deleted_files": false,
  "set_unsaved_view_name": true,
  // File opens can target the current window, Finder/Dock only, or all sources.
  "open_files_in_new_window": "never",
  // ST4 4143: https://www.sublimetext.com/download
  "update_system_recent_files": true,
  // ST4 4107 and 4126: https://www.sublimetext.com/download
  // Keep the new display modes opt-in in Velocity.
  "draw_unicode_white_space": "none",
  "draw_unicode_bidi": false,
  "draw_control_characters": false,
  // ST4 image selection setting: https://www.sublimetext.com/download
  // These are the formats supported by Velocity's decoder.
  "image_file_patterns": ["*.png", "*.jpg", "*.jpeg", "*.gif"],
  "show_errors_inline": true,
  "index_files": true,
  "index_workers": 0,
  // https://www.sublimetext.com/docs/indexing.html#settings
  "index_exclude_patterns": ["*.log"],
  "index_include_patterns": [],
  "index_exclude_gitignore": true,
  "index_skip_unknown_extensions": true,
  "show_definitions": true,
  "auto_complete": true,
  "auto_complete_delay": 50,
  "auto_complete_size_limit": 4194304,
  "auto_complete_commit_on_tab": false,
  "auto_complete_with_fields": false,
  "auto_complete_cycle": false,
  "auto_complete_when_likely": true,
  "auto_complete_use_index": true,
  "auto_complete_include_snippets": true,
  // Lane A round 18: editing, find and completion preferences.
  // Align a new line with the column just after an unmatched parenthesis or bracket.
  "indent_to_bracket": false,
  // Seed Find, Replace and Incremental Find from a single-line selection.
  "find_selected_text": true,
  // Restrict a newly opened find panel to a multi-line selection.
  "auto_find_in_selection": false,
  // Close Find after its Find All button runs.
  "close_find_after_find_all": true,
  // Close Replace after its Replace All button runs.
  "close_find_after_replace_all": true,
  // Let Up and Down reach document limits from the first and last visual rows.
  "move_to_limit_on_up_down": false,
  // Finish the innermost HTML or XML closing tag when a slash follows a less-than sign.
  "auto_close_tags": true,
  // Include punctuation inferred from other occurrences of a completed word.
  "auto_complete_trailing_symbols": false,
  // Infer a space at the immediate end of line from repeated, mostly consistent occurrences.
  "auto_complete_trailing_spaces": false,
  // Save changed files when their tab or window loses focus.
  "save_on_focus_lost": false,
  // Limit automatic suggestions to code and tags, excluding comments and multi-line strings.
  "auto_complete_selector": "meta.tag, source - comment - string.quoted.double.block - string.quoted.single.block - string.unquoted.heredoc",
  // Use prior completion choices when ordering candidates.
  "auto_complete_use_history": true,
  // Rank by match (none), match and likelihood (some), or source order (strict).
  "auto_complete_preserve_order": "some",
  // Include snippet candidates in suggestions opened by typing.
  "auto_complete_include_snippets_when_typing": true,
  // Extra triggers accept a selector, optional characters and an optional rhs_empty flag.
  "auto_complete_triggers": [],
  "show_git_status": true,
  "show_git_status_in_status_bar": true,
  "git_diff_target": "index",
  "mini_diff": true,
  "spell_check": false,
  // Public scope selector reference: https://sublime-text-unofficial-documentation.readthedocs.io/en/latest/reference/settings.html#system-and-miscellaneous-settings
  "spelling_selector": "markup.raw, source string.quoted - punctuation - meta.preprocessor.c.include, source comment - source comment.block.preprocessor, -(source, constant, keyword, storage, support, variable, markup.underline.link, meta.tag)",
  "dictionary": "Packages/Language - English/en_US.dic",
  "added_words": [],
  "ignored_words": [],
  "sublime_merge_path": "",
  // https://www.sublimetext.com/docs/vintage.html#enabling-vintage
  "ignored_packages": ["Vintage"],
  "vintage_enabled": false,
  "vintage_start_in_command_mode": false,
  // Null uses the documented platform default (enabled on macOS).
  // https://www.sublimetext.com/docs/vintage.html#ctrl-keys
  "vintage_ctrl_keys": null,
  "vintage_use_clipboard": false,
  "theme": "auto",
  "dark_theme": "Velocity.sublime-theme",
  "light_theme": "Velocity Light.sublime-theme",
  "ui_scale": 1.0,
  "ui_font_size": 12,
  "animation_enabled": true,
  // Explicit HTTPS index; no registry, timer or network request is enabled by default.
  "package_index_url": null,
  "overlay_scroll_bars": "system",
  "themed_title_bar": true,
  "file_tab_style": "angled",
  "show_tab_close_buttons": true,
  "show_tab_close_buttons_on_left": false,
  // Huge documents: inclusive thresholds; explicit view feature commands override degradation.
  "large_file.load_bytes": 67108864,
  "large_file.viewport_bytes": 67108864,
  "large_file.viewport_lines": 1000000,
  "large_file.long_line_bytes": 16384,
  "large_file.indexing_bytes": 67108864,
  "large_file.wrap_bytes": 16777216,
  "large_file.spell_bytes": 16777216,
  "large_file.diff_bytes": 67108864,
  "large_file.minimap_lines": 10000,
  "large_file.max_line_bytes": 16384,
  "large_file.max_viewport_lines": 512,
  "large_file.max_lookback_lines": 256,
  "large_file.checkpoint_interval": 1024,
  "large_file.max_checkpoints": 128
}
