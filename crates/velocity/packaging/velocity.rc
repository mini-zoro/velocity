// Substituted by build.rs using the Cargo package version.
101 ICON "velocity.ico"

1 VERSIONINFO
 FILEVERSION @VERSION_COMMAS@
 PRODUCTVERSION @VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Velocity Contributors"
            VALUE "FileDescription", "@DESCRIPTION@"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "@EXE@"
            VALUE "OriginalFilename", "@EXE@.exe"
            VALUE "ProductName", "Velocity"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
